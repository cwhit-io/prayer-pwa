[Unit]
Description=Fort Wayne Prays reverse proxy — fortwayneprays.org:3000
Documentation=https://fortwayneprays.org
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blackhawk
Group=blackhawk
WorkingDirectory=/home/blackhawk/prayer-pwa
Environment=NODE_ENV=production
Environment=PROXY_LISTEN=3000
Environment=PROXY_HOST=0.0.0.0
Environment=PROXY_FORWARDED_PROTO=https
Environment=UPSTREAM_FILE=/home/blackhawk/prayer-pwa/releases/upstream.port
# Cloudflare Tunnel ingress: fortwayneprays.org → http://10.10.96.138:3000
ExecStart=/usr/bin/node /home/blackhawk/prayer-pwa/deploy/proxy.mjs
Restart=always
RestartSec=2
TimeoutStartSec=15
TimeoutStopSec=10

[Install]
WantedBy=default.target
